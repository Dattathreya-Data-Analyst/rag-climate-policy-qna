# =============================================================================
# RAG Q&A System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# LLM Provider: "groq" or "ollama"
# - groq: Cloud-based, fast, free tier available (https://console.groq.com)
# - ollama: Local inference, no API key needed (https://ollama.ai)
LLM_PROVIDER=groq

# Groq API Key (required if LLM_PROVIDER=groq)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=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

# Groq Model (used when LLM_PROVIDER=groq)
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Model (used when LLM_PROVIDER=ollama)
# Make sure to pull the model first: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.2:3b

# Ollama Base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Embedding Configuration
# =============================================================================

# Embedding Model: "minilm", "bge", "nomic"
# - minilm: all-MiniLM-L6-v2 (fast, 384d)
# - bge: BAAI/bge-small-en-v1.5 (balanced, 384d)
# - nomic: nomic-embed-text (via Ollama, 768d)
EMBEDDING_MODEL=bge

# =============================================================================
# RAG Pipeline Configuration
# =============================================================================

# Chunking Strategy: "fixed", "recursive", "semantic", "sentence"
CHUNKING_STRATEGY=recursive

# Chunk Size (in characters)
CHUNK_SIZE=1000

# Chunk Overlap (in characters)
CHUNK_OVERLAP=200

# Number of documents to retrieve
TOP_K=5

# Similarity score threshold (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.5
